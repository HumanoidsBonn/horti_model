<?xml version="1.0"?>
<robot name="depth_camera" xmlns:xacro="http://ros.org/wiki/xacro">

<xacro:macro name="depth_camera" params="prefix:='' camera_name:='camera' hfov:='100' min_depth:='0.07' max_depth:='0.50' parent:=link_eef xyz:='0 0 0' rpy:='0 ${pi/-2.0} ${pi/-2.0}'">
<!-- axis directions: x -> viewing direction; y: left; z: up -->

<link name="${prefix}${camera_name}_link"/>

<joint name="${prefix}${parent}_${camera_name}-link_fixed_joint" type="fixed">
  <origin xyz="${xyz}" rpy="${rpy}"/>
  <parent link="${prefix}${parent}"/>
  <child link="${prefix}${camera_name}_link"/>
</joint>

<link name="${prefix}${camera_name}_color_optical_frame"/>

<joint name="${prefix}${camera_name}-link_${camera_name}-depth_fixed_joint" type="fixed">
  <origin xyz="0 0 0" rpy="${pi/-2.0} 0 ${pi/-2.0}"/>
  <parent link="${prefix}${camera_name}_link"/>
  <child link="${prefix}${camera_name}_color_optical_frame"/>
</joint>

<gazebo reference="${prefix}${camera_name}_link">
  <sensor name="${prefix}${camera_name}" type="depth">
    <update_rate>20</update_rate>
    <camera>
      <horizontal_fov>${hfov*pi/180}</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>B8G8R8</format>
      </image>
      <clip>
        <near>${min_depth}</near>
        <far>${max_depth}</far>
      </clip>
    </camera>
    <plugin name="${prefix}${camera_name}_controller" filename="libgazebo_ros_openni_kinect.so">
      <baseline>0.05</baseline>
      <alwaysOn>true</alwaysOn>
      <updateRate>1.0</updateRate>
      <cameraName>${prefix}${camera_name}</cameraName>
      <imageTopicName>/${prefix}${camera_name}/color/image_raw</imageTopicName>
      <cameraInfoTopicName>/${prefix}${camera_name}/color/camera_info</cameraInfoTopicName>
      <depthImageTopicName>/${prefix}${camera_name}/depth/image_raw</depthImageTopicName>
      <depthImageCameraInfoTopicName>/${prefix}${camera_name}/depth/camera_info</depthImageCameraInfoTopicName>
      <pointCloudTopicName>/${prefix}${camera_name}/depth_registered/points</pointCloudTopicName>
      <frameName>${prefix}${camera_name}_color_optical_frame</frameName>
      <pointCloudCutoff>${min_depth}</pointCloudCutoff>
      <pointCloudCutoffMax>${max_depth}</pointCloudCutoffMax>
      <distortionK1>0.0</distortionK1>
      <distortionK2>0.0</distortionK2>
      <distortionK3>0.0</distortionK3>
      <distortionT1>0.0</distortionT1>
      <distortionT2>0.0</distortionT2>
      <CxPrime>0</CxPrime>
      <Cx>0</Cx>
      <Cy>0</Cy>
      <focalLength>0</focalLength>
      <hackBaseline>0</hackBaseline>
    </plugin>
  </sensor>
</gazebo>

</xacro:macro>
</robot>