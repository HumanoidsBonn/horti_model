            <mass value="5.0" />
            <origin rpy="0 0 0" xyz="0.0 0.0 0.00" />
            <inertia ixx="0.0468" iyy="0.07" izz="0.75" ixy="0.0" ixz="0.0" iyz="0.0" />
        </inertial>

    </link> 
    <joint name="arm_holder_joint" type="fixed">
        <origin rpy="0 0 3.14159" xyz="0.75 0 0.0" />
