    <material name="gray">
        <color rgba="0.4 0.4 0.4 1" />
    </material>
    <material name="Black">
        <color rgba="0.0 0.0 0.0 1.0" />
    </material>
    <material name="Red">
        <color rgba="0.8 0.0 0.0 1.0" />
    </material>
    <material name="White">
        <color rgba="1.0 1.0 1.0 1.0" />
    </material>
    <material name="Silver">
        <color rgba="0.753 0.753 0.753 1.0" />
    </material>
    <link name="base_link" />
    <!-- Trolley -->
    <link name="trolley_base_link">
        <visual>
            <material name="gray" />
            <geometry>
                <mesh filename="package://horti_description/meshes/trolley_base.stl" scale="0.001 0.001 0.001" />
            </geometry>
            <origin xyz="0 0 0.0" rpy="0 0 ${pi}"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://horti_description/meshes/trolley_base.stl" scale="0.001 0.001 0.001" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
        </collision>
        
        <inertial>
            <mass value="100.0"/>        
            <origin rpy="0 0 0" xyz="0.727568 -0.022890 0.222313"/>
            <inertia ixx="10.2233" ixy="0" ixz="0" iyy="20.3911" iyz="0" izz="15.1202"/>
        </inertial>

    </link>
    <joint name="trolley_base_joint" type="fixed">
        <parent link="base_link" />
        <child link="trolley_base_link" />
        <origin rpy="0 0 0" xyz="0 0 0.2" />
    </joint>
    <link name="trolley_platform_link">
        <visual>
            <material name="gray" />
            <geometry>
                <mesh filename="package://horti_description/meshes/trolley_platform.stl" scale="0.001 0.001 0.001" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://horti_description/meshes/trolley_platform.stl" scale="0.001 0.001 0.001" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
        </collision>
        <inertial>
            <mass value="10.0"/>
            <origin rpy="0 0 0" xyz="0.722708 0.000002 -0.039040"/>
            <inertia ixx="0.174859" ixy="0.0" ixz="0.008806" iyy="1.750794" iyz="0.0" izz="1.903953"/>
        </inertial>

    </link>
    <joint name="trolley_platform_joint" type="fixed">
        <parent link="trolley_base_link" />
        <child link="trolley_platform_link" />
        <origin rpy="0 0 0" xyz="0.025734 0.000458 0.469001" />
        <axis xyz="0 0 1" />
        <limit effort="1000" lower="0" upper="2.2" velocity="1000.00" />
    </joint>
    <link name="arm_holder_link">
        <visual>
            <material name="gray" />
            <origin rpy="0 0 0" xyz="0 0 0.05" />
            <geometry>
                <box size="1.3 0.32 0.1" />
            </geometry>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0.05" />
            <geometry>
                <box size="1.3 0.32 0.1" />
            </geometry>
        </collision>
        
