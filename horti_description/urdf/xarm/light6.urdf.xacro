<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:macro name="light6_urdf" params="prefix">

        <link name ="${prefix}_base_link">
            <visual>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/light6/base.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
            <collision>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/light6/base.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
            <inertial>
            <origin xyz="0.0 0.0 0.09103" rpy="0 0 0" />
            <mass value="2.7" />
            <inertia
                ixx="0.00494875"
                ixy="-3.5E-06"
                ixz="1.25E-05"
                iyy="0.00494174"
                iyz="1.67E-06"
                izz="0.002219" />
      </inertial>
        </link>

        <link name ="${prefix}_link1">
            <visual>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/light6/link1.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
            <collision>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/light6/link1.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
             <inertial>
        <origin xyz="-0.002 0.02692 -0.01332" rpy="0 0 0"/>
        <mass value="2.16"/>
        <inertia
          ixx="0.00539427"
          ixy="1.095E-05"
          ixz="1.635E-06"
          iyy="0.0048979"
          iyz="0.000793"
          izz="0.00311573"/>
      </inertial>
        </link>

        <joint name="${prefix}_joint1" type="revolute" >
            <origin xyz="0 0 0.173" rpy="0 0 0" />
            <parent link="${prefix}_base_link" />
            <child link="${prefix}_link1" />
            <axis xyz="0 0 1" />
            <limit lower="${-2* pi}" upper="${2 * pi }" effort="20" velocity="3.14" />
            <dynamics damping="1" friction="1"/>
        </joint>

        <link name ="${prefix}_link2">
            <visual>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/light6/link2.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
            <collision>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/light6/link2.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
            <inertial>
            <origin
                xyz="0.03531 -0.21398 0.03386"
                rpy="0 0 0" />
            <mass
                value="1.71" />
            <inertia
                ixx="0.0248674"
                ixy="-0.00430651"
                ixz="-0.00067797"
                iyy="0.00485548"
                iyz="0.00457245"
                izz="0.02387827" />
            </inertial>
        </link>

        <joint name="${prefix}_joint2" type="revolute" >
            <origin xyz="0 0.073 0.07" rpy="0 0 0" />
            <parent link="${prefix}_link1" />
            <child link="${prefix}_link2" />
            <axis xyz="0 1 0" />
            <limit lower="${-2* pi}" upper="${2 * pi }" effort="20" velocity="3.14" />
            <dynamics damping="1" friction="1"/>
        </joint>

        <link name ="${prefix}_link3">
            <visual>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/light6/link3.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
            <collision>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/light6/link3.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
            <inertial>
            <origin
                xyz="0.06781 0.10749 0.01457"
                rpy="0 0 0" />
            <mass
                value="1.384" />
            <inertia
                ixx="0.0053694"
                ixy="0.0014185"
                ixz="-0.00092094"
                iyy="0.0032423"
                iyz="-0.00169178"
                izz="0.00501731" />
            </inertial>
        </link>

        <joint name="${prefix}_joint3" type="revolute" >
            <origin xyz="0 -0.028 0.2" rpy="0 0 0" />
            <parent link="${prefix}_link2" />
            <child link="${prefix}_link3" />
            <axis xyz="0 1 0" />
            <limit lower="${-2* pi}" upper="${2 * pi }" effort="20" velocity="3.14" />
            <dynamics damping="1" friction="1"/>
        </joint>

        <link name ="${prefix}_link4">
            <visual>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/light6/link4.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
            <collision>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/light6/link4.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="-0.00021 0.02578 -0.02538" rpy="0 0 0"/>
                <mass value="1.115"/>
                <inertia
                ixx="0.00439263"
                ixy="5.028E-05"
                ixz="1.374E-05"
                iyy="0.0040077"
                iyz="0.00045338"
                izz="0.00110321"/>
            </inertial>
        </link>

        <joint name="${prefix}_joint4" type="revolute" >
            <origin xyz="0.087 -0.0447 -0.035" rpy="0 0 0" />
            <parent link="${prefix}_link3" />
            <child link="${prefix}_link4" />
            <axis xyz="0 0 1" />
            <limit lower="${-2* pi}" upper="${2 * pi }" effort="20" velocity="3.14" />
            <dynamics damping="1" friction="1"/>
        </joint>

        <link name ="${prefix}_link5">
            <visual>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/light6/link5.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
            <collision>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/light6/link5.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
            <inertial>
                <origin
                    xyz="0.05428 0.01781 0.00543"
                    rpy="0 0 0" />
                <mass
                    value="1.275" />
                <inertia
                    ixx="0.001202758"
                    ixy="0.000492428"
                    ixz="-0.00039147"
                    iyy="0.0022876"
                    iyz="-1.235E-04"
                    izz="0.0026866" />
            </inertial>
        </link>

        <joint name="${prefix}_joint5" type="revolute" >
            <origin xyz="0 0.0415 -0.1921" rpy="0 0 0" />
            <parent link="${prefix}_link4" />
            <child link="${prefix}_link5" />
            <axis xyz="0 1 0" />
            <limit lower="${-2* pi}" upper="${2 * pi }" effort="20" velocity="3.14" />
            <dynamics damping="1" friction="1"/>
        </joint>

        <link name ="${prefix}_link6">
            <visual>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/light6/link6.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
            <collision>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/light6/link6.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
            <inertial>
            <origin
                xyz="0 0.00064 -0.00952"
                rpy="0 0 0" />
            <mass
                value="0.1096" />
            <inertia
                ixx="4.5293E-05"
                ixy="0"
                ixz="0"
                iyy="4.8111E-05"
                iyz="0"
                izz="7.9715E-05" />
            </inertial>
        </link>

        <joint name="${prefix}_joint6" type="revolute" >
            <origin xyz="0 -0.0415 -0.0408" rpy="0 0 0" />
            <parent link="${prefix}_link5" />
            <child link="${prefix}_link6" />
            <axis xyz="0 0 1" />
            <limit lower="${-2* pi}" upper="${2 * pi }" effort="20" velocity="3.14" />
            <dynamics damping="1" friction="1"/>
        </joint>

        <link name="${prefix}_eef_link" />

        <joint name="${prefix}_eef_joint" type="fixed" >
            <origin xyz="0 0 -0.0245" rpy="${pi} 0 0" />
            <parent link="${prefix}_link6" />
            <child link="${prefix}_eef_link" />
        </joint>


    </xacro:macro>


</robot>
