<?xml version="1.0"?>
<robot name="horti" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- 	<xacro:include filename="$(find avatar_model)/robots/helpers.urdf.xacro" /> -->
<!-- 	<xacro:property name="arm_height" value="1.1" /> -->

    <xacro:include filename="$(find horti_description)/robots/xarm7.urdf.xacro" />
    <xacro:include filename="$(find horti_description)/robots/light6.urdf.xacro" />

	<material name="gray">
		<color rgba="0.4 0.4 0.4 1"/>
	</material>

    <material name="Black">
      <color rgba="0.0 0.0 0.0 1.0"/>
    </material>

    <material name="Red">
      <color rgba="0.8 0.0 0.0 1.0"/>
    </material>

    <material name="White">
      <color rgba="1.0 1.0 1.0 1.0"/>
    </material>

    <material name="Silver">
      <color rgba="0.753 0.753 0.753 1.0"/>
    </material>




    <xacro:property name="holder_length" value="1.3" />
    <xacro:property name="holder_width" value="0.32" />
    <xacro:property name="holder_height" value="0.1" />
    <xacro:property name="arm_width" value="0.6" />
    <xacro:property name="arm_y_offset" value="0.08" />




<link name="base_link" />


<!-- Trolley -->

	<link name="trolley_base_link">
		<visual>
			<material name="gray" />
			<geometry>
				<mesh filename="package://horti_description/meshes/trolley_base.stl" scale="0.001 0.001 0.001" />
			</geometry>
		</visual>
		<collision>
        <geometry>
          <mesh filename="package://horti_description/meshes/trolley_base.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>
	</link>
	<joint name="trolley_base_joint" type="fixed">
		<parent link="base_link" />
		<child link="trolley_base_link" />
		<origin xyz="0 0 0" rpy="0 0 0" />
	</joint>

	<link name="trolley_platform_link">
		<visual>
			<material name="gray" />
			<geometry>
				<mesh filename="package://horti_description/meshes/trolley_platform.stl" scale="0.001 0.001 0.001" />
			</geometry>
		</visual>
		<collision>
        <geometry>
          <mesh filename="package://horti_description/meshes/trolley_platform.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
		</collision>
	</link>
	<joint name="trolley_platform_joint" type="prismatic">
		<parent link="trolley_base_link" />
		<child link="trolley_platform_link" />
        <origin xyz="0.025734 0.000458 0.469001" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit upper="2.2" lower="0" effort="1000" velocity="1000.00"/>
	</joint>


    <link name="arm_holder_link">
        <visual>
            <material name="gray" />
            <origin xyz="0 0 -${holder_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${holder_length} ${holder_width} ${holder_height}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -${holder_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${holder_length} ${holder_width} ${holder_height}" />
            </geometry>
        </collision>
    </link>
    <joint name="arm_holder_joint" type="fixed" >
        <origin xyz="${-holder_length / 2 - 0.1} 0 ${holder_height}" rpy="0 0 0" />
        <parent link="trolley_platform_link" />
        <child link="arm_holder_link" />
    </joint>




<!-- Arms -->

    <xacro:xarm7_urdf prefix="arm_left_"/>

    <joint name="arm_left_base_joint" type="fixed" >
        <origin xyz="${-arm_width / 2} ${-arm_y_offset} 0" rpy="0 0 ${-pi/2}" />
        <parent link="arm_holder_link" />
        <child link="arm_left_link_base" />
    </joint>

    <xacro:xarm7_urdf prefix="arm_right_"/>

    <joint name="arm_right_base_joint" type="fixed" >
        <origin xyz="${arm_width / 2} ${-arm_y_offset} 0" rpy="0 0 ${-pi/2}" />
        <parent link="arm_holder_link" />
        <child link="arm_right_link_base" />
    </joint>


<!-- Head -->

    <xacro:light6_urdf prefix="head" />
    <joint name="head_base_joint" type="fixed" >
        <origin xyz="0 0 0" rpy="0 0 -${pi/2}" />
        <parent link="arm_holder_link" />
        <child link="head_base_link" />
    </joint>



</robot>
