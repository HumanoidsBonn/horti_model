<?xml version="1.0"?>
<robot name="horti" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="capsule-collision" params="e1 e2 rad len rpy mid">
		<collision>
			<origin rpy="${rpy}" xyz="${e1}" />
			<geometry>
				<sphere radius="${rad}" />
			</geometry>
		</collision>
		<collision>
			<origin rpy="${rpy}" xyz="${mid}" />
			<geometry>
				<cylinder length="${len}" radius="${rad}" />
			</geometry>
		</collision>
		<collision>
			<origin rpy="${rpy}" xyz="${e2}" />
			<geometry>
				<sphere radius="${rad}" />
			</geometry>
		</collision>
	</xacro:macro>

    <xacro:macro name="horti_bot" params="limited:='false' effort_control:='false' enable_d435i:='true'">

    <material name="gray">
		<color rgba="0.4 0.4 0.4 1"/>
	</material>
	 <material name="Black">
      <color rgba="0.0 0.0 0.0 1.0"/>
    </material>

    <material name="Red">
      <color rgba="0.8 0.0 0.0 1.0"/>
    </material>

    <material name="White">
      <color rgba="1.0 1.0 1.0 1.0"/>
    </material>

    <material name="Silver">
      <color rgba="0.753 0.753 0.753 1.0"/>
    </material>

    <xacro:include filename="$(find horti_description)/urdf/inc/xarm/xarm7_robot_macro.xacro" />
    <!-- <xacro:include filename="$(find horti_description)/urdf/inc/xarm/lite6_robot_macro.xacro" /> -->
    <xacro:include filename="$(find horti_description)/urdf/inc/trolley/trolley_macro.xacro" />
    <xacro:include filename="$(find horti_description)/urdf/inc/sensors/zed/zed_macro.urdf.xacro" />
    <xacro:include filename="$(find horti_description)/urdf/inc/sensors/d405/d405.urdf.xacro" />
    <xacro:include filename="$(find horti_description)/urdf/inc/gripper/horti_gripper_macro.urdf.xacro" />
    <xacro:include filename="$(find horti_description)/urdf/horti_calibration.urdf.xacro" />

    <xacro:property name="enable_cali_marker" value="false"/>

    <!-- Trolley -->

    <xacro:property name="holder_length" value="1.44" />
    <xacro:property name="holder_width" value="0.42" />
    <xacro:property name="holder_height" value="0.03" />
    <xacro:property name="arm_width" value="0.7" />
    <xacro:property name="arm_y_offset" value="-0.1" />

    <xacro:trollomatic prefix="trolley_" enable_collisions="false" enable_inertia="false" joint_type="fixed"/>
    <joint name="base_link_joint" type="fixed" >
        <origin xyz="0.0 0 -0.469" rpy="0.0 0 -3.14159" />
        <parent link="world" />
        <child link="trolley_base_link" />
    </joint>

    <link name="arm_holder_link">
        <visual>
            <material name="gray" />
            <origin xyz="0 0 -${holder_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${holder_length} ${holder_width} ${holder_height}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -${holder_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${holder_length} ${holder_width} ${holder_height}" />
            </geometry>
        </collision>
    </link>
    <joint name="arm_holder_joint" type="fixed" >
        <origin xyz="${-holder_length / 2} 0 ${holder_height+0.05}" rpy="0 0 0" />
        <parent link="trolley_platform_link" />
        <child link="arm_holder_link" />
    </joint>
    <!--
    <xacro:property name="back_height" value="1.5" />
    <link name="trolley_back_link">
        <collision>
            <origin xyz="0 0 ${back_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${holder_length} 0.001 ${back_height}" />
            </geometry>
        </collision>
    </link>
    <joint name="trolley_back_joint" type="fixed" >
        <origin xyz="${-holder_length / 2} ${holder_width / 2 + 0.05} 0" rpy="0 0 0" />
        <parent link="trolley_platform_link" />
        <child link="trolley_back_link" />
    </joint>
    -->

    <xacro:property name="power_height" value="0.35" />
    <xacro:property name="power_width" value="0.10" />
    <xacro:property name="power_length" value="0.45" />
    <link name="power_link" >
        <visual>
            <material name="gray" />
            <origin xyz="0 ${-power_width / 2} ${power_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${power_length} ${power_width} ${power_height}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 ${-power_width / 2} ${power_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${power_length} ${power_width} ${power_height}" />
            </geometry>
        </collision>
    </link>
    <joint name="power_joint" type="fixed">
        <parent link="trolley_base_link"/>
        <child link="power_link" />
        <origin xyz="${-1.44 / 2} ${-0.42 / 2 - 0.01} 0.18" rpy="0 0 0" />
    </joint>


    <xacro:property name="base_control_height" value="0.12" />
    <xacro:property name="base_control_width" value="0.15" />
    <xacro:property name="base_control_length" value="0.3" />
    <link name="base_control_link" >
        <visual>
            <material name="gray" />
            <origin xyz="0 ${-base_control_width / 2} ${base_control_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${base_control_length} ${base_control_width} ${base_control_height}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 ${-base_control_width / 2} ${base_control_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${base_control_length} ${base_control_width} ${base_control_height}" />
            </geometry>
        </collision>
    </link>
    <joint name="base_control_joint" type="fixed">
        <parent link="trolley_base_link"/>
        <child link="base_control_link" />
        <origin xyz="${-1.44 / 2 + 0.5} ${-0.42 / 2 - 0.01} 0.18" rpy="0 0 0" />
    </joint>


<xacro:property name="basket_height" value="0.14" />
    <xacro:property name="basket_width" value="0.25" />
    <xacro:property name="basket_length" value="0.37" />
    <xacro:property name="basket_wall_thickness" value="0.01" />

    <link name="basket_link" >
        <visual>
            <material name="gray" />
            <origin xyz="0 0 ${basket_height + basket_wall_thickness / 2 + 0.04}" rpy="0 0 0" />
            <geometry>
                <box size="${basket_length} ${basket_width} ${basket_wall_thickness}" />
            </geometry>
        </visual>
        <visual>
            <material name="gray" />
            <origin xyz="${basket_length / 2 + basket_wall_thickness / 2} 0 ${basket_height / 2 + basket_wall_thickness / 2 + 0.04}" rpy="0 0 0" />
            <geometry>
                <box size="${basket_wall_thickness} ${basket_width} ${basket_height + basket_wall_thickness}" />
            </geometry>
        </visual>
        <visual>
            <material name="gray" />
            <origin xyz="-${basket_length / 2 + basket_wall_thickness / 2} 0 ${basket_height / 2 + basket_wall_thickness / 2 + 0.04}" rpy="0 0 0" />
            <geometry>
                <box size="${basket_wall_thickness} ${basket_width} ${basket_height + basket_wall_thickness}" />
            </geometry>
        </visual>
        <visual>
            <material name="gray" />
            <origin xyz="0 ${basket_width / 2 + basket_wall_thickness / 2} ${basket_height / 2 + basket_wall_thickness / 2 + 0.04}" rpy="0 0 0" />
            <geometry>
                <box size="${basket_length + 2 * basket_wall_thickness} ${basket_wall_thickness} ${basket_height + basket_wall_thickness}" />
            </geometry>
        </visual>
        <visual>
            <material name="gray" />
            <origin xyz="0 -${basket_width / 2 + basket_wall_thickness / 2} ${basket_height / 2 + basket_wall_thickness / 2 + 0.04}" rpy="0 0 0" />
            <geometry>
                <box size="${basket_length + 2 * basket_wall_thickness} ${basket_wall_thickness} ${basket_height + basket_wall_thickness}" />
            </geometry>
        </visual>
        <collision>
            <material name="gray" />
            <origin xyz="0 0 ${basket_height + basket_wall_thickness / 2 + 0.04}" rpy="0 0 0" />
            <geometry>
                <box size="${basket_length} ${basket_width} ${basket_wall_thickness}" />
            </geometry>
        </collision>
        <collision>
            <material name="gray" />
            <origin xyz="${basket_length / 2 + basket_wall_thickness / 2} 0 ${basket_height / 2 + basket_wall_thickness / 2 + 0.04}" rpy="0 0 0" />
            <geometry>
                <box size="${basket_wall_thickness} ${basket_width} ${basket_height + basket_wall_thickness}" />
            </geometry>
        </collision>
        <collision>
            <material name="gray" />
            <origin xyz="-${basket_length / 2 + basket_wall_thickness / 2} 0 ${basket_height / 2 + basket_wall_thickness / 2 + 0.04}" rpy="0 0 0" />
            <geometry>
                <box size="${basket_wall_thickness} ${basket_width} ${basket_height + basket_wall_thickness}" />
            </geometry>
        </collision>
        <collision>
            <material name="gray" />
            <origin xyz="0 ${basket_width / 2 + basket_wall_thickness / 2} ${basket_height / 2 + basket_wall_thickness / 2 + 0.04}" rpy="0 0 0" />
            <geometry>
                <box size="${basket_length + 2 * basket_wall_thickness} ${basket_wall_thickness} ${basket_height + basket_wall_thickness}" />
            </geometry>
        </collision>
        <collision>
            <material name="gray" />
            <origin xyz="0 -${basket_width / 2 + basket_wall_thickness / 2} ${basket_height / 2 + basket_wall_thickness / 2 + 0.04}" rpy="0 0 0" />
            <geometry>
                <box size="${basket_length + 2 * basket_wall_thickness} ${basket_wall_thickness} ${basket_height + basket_wall_thickness}" />
            </geometry>
        </collision>
    </link>
    <joint name="basket_joint" type="fixed">
        <parent link="arm_holder_link"/>
        <child link="basket_link" />
        <origin xyz="${-holder_length / 2 + basket_length / 2 + basket_wall_thickness} ${-holder_width / 2 - basket_width / 2 - basket_wall_thickness} 0.06" rpy="${pi} 0 0" />
    </joint>

    <xacro:property name="controller_height" value="0.12" />
    <xacro:property name="controller_width" value="0.32" />
    <xacro:property name="controller_length" value="0.15" />

    <link name="arm_right_controller_link" >
        <visual>
            <material name="gray" />
            <origin xyz="0 0 ${controller_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${controller_length} ${controller_width} ${controller_height}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 ${controller_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${controller_length} ${controller_width} ${controller_height}" />
            </geometry>
        </collision>
    </link>
    <joint name="arm_right_controller_joint" type="fixed" >
        <origin xyz=" ${-1.44 + 0.05 + controller_length /2} 0 ${holder_height+0.05}" rpy="0 0 0" />
        <child link="arm_right_controller_link" />
        <parent link="trolley_platform_link" />
    </joint>

    <link name="arm_left_controller_link" >
        <visual>
            <material name="gray" />
            <origin xyz="0 0 ${controller_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${controller_length} ${controller_width} ${controller_height}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 ${controller_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${controller_length} ${controller_width} ${controller_height}" />
            </geometry>
        </collision>
    </link>
    <joint name="arm_left_controller_joint" type="fixed" >
        <origin xyz=" ${-0.05-controller_length  / 2} 0 ${holder_height+0.05}" rpy="0 0 0" />
        <child link="arm_left_controller_link" />
        <parent link="trolley_platform_link" />
    </joint>



    <link name="trolley_local_link" />
    <joint name="trolley_local_joint" type="fixed" >
        <origin xyz="0 0 0" rpy="0 0 ${pi}" />
        <parent link="trolley_platform_link" />
        <child link="trolley_local_link" />
    </joint>

<!-- Arms -->

    <xacro:xarm7_robot prefix="arm_right_" namespace="" limited="false" attach_to='arm_holder_link' xyz="${-arm_width / 2} ${arm_y_offset} 0.0" rpy="0 0 ${-pi/2}" />


     <!-- left arm calibration link -->
    <link name="arm_left_calib_link" />
    <joint name="arm_left_calib_joint" type="fixed" >
        <parent link="arm_holder_link" />
        <child link="arm_left_calib_link" />
        <origin xyz="${arm_width / 2} ${arm_y_offset} 0.0" rpy="0 ${0 * pi / 180.0} ${-pi/2}" />
    </joint>

    <link name="arm_left_mount_link" />
    <joint name="arm_left_mount_joint" type="fixed" >
        <parent link="arm_left_calib_link" />
        <child link="arm_left_mount_link" />
        <xacro:left_arm_calib />
    </joint>

    <xacro:xarm7_robot prefix="arm_left_" namespace="" limited="false" attach_to='arm_left_mount_link' xyz="0 0 0" rpy="0 0 0" />


<!-- FT-Sensors -->

    <xacro:property name="ft_height" value="0.0364" />
	<xacro:property name="ft_radius" value="0.04" />

    <xacro:macro name="ft_and_gripper" params="prefix parent">

        <link name="${prefix}_ft_link">
            <visual>
                <origin xyz="0 0 -${ft_height}" rpy="0 0 0" />
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/ft_sensor/FT_Sensor_Calib_Holder.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 -${ft_height/2}" rpy="0 0 0" />
                <material name="gray" />
                <geometry>
                    <cylinder radius="${ft_radius}" length="${ft_height}" />
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}_ft_joint" type="fixed">
            <origin xyz="0 0 ${ft_height}" rpy="0 0 0" />
            <parent link="${parent}" />
            <child link="${prefix}_ft_link" />
        </joint>
    </xacro:macro>

    <xacro:ft_and_gripper prefix="arm_right" parent="arm_right_link7" />
    <xacro:ft_and_gripper prefix="arm_left" parent="arm_left_link7" />

    <!-- right gripper & eef link -->

<!--    <link name="arm_right_gripper_link">
        <visual>
            <material name="gray" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://horti_description/meshes/gripper/HortiGripperWide.stl" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://horti_description/meshes/gripper/HortiGripperWide_collision.stl" scale="0.1 0.1 0.1" />
            </geometry>
        </collision>
    </link>

    <joint name="arm_right_gripper_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 ${-pi/4}" />
        <parent link="arm_right_ft_link" />
        <child link="arm_right_gripper_link" />
    </joint>-->

    <!--<link name="arm_right_eef_link" />
    <joint name="arm_right_eef_joint" type="fixed" >
        <origin xyz="0 0 0.08" rpy="0 0 0" />
        <parent link="arm_right_gripper_link" />
        <child link="arm_right_eef_link" />
    </joint>-->

    <xacro:servo_gripper prefix="" parent="arm_right_ft_link" >
        <origin xyz="0 0 0" rpy="0 0 ${pi/4}" />
    </xacro:servo_gripper>


    <link name="arm_right_gripper_link" />
    <joint name="arm_right_gripper_joint" type="fixed" >
        <origin xyz="0 0 0.0" rpy="0 0 0" />
        <parent link="servo_holder_link" />
        <child link="arm_right_gripper_link" />
    </joint>

    <link name="arm_right_eef_link" />
    <joint name="arm_right_eef_joint" type="fixed" >
	<origin xyz="0 0 0.11" rpy="0 0 ${-pi/2}" />
        <parent link="arm_right_gripper_link" />
        <child link="arm_right_eef_link" />
    </joint>

    <!-- left gripper & eef link -->

    <link name="arm_left_cutter_link">
        <visual>
            <material name="gray" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://horti_description/meshes/cutter/ass_shearer_2024_09_30_001.STL" scale="0.001 0.001 0.001" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.01" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.02" radius="0.04" />
            </geometry>
        </collision>
       <collision>
            <origin xyz="0 0.015 0.06" rpy="0 0 0" />
            <geometry>
                <box size="0.05 0.055 0.08"/>
            </geometry>
        </collision>
        <collision>
            <origin xyz="0 0.00 0.11" rpy="0 0 0" />
            <geometry>
                <box size="0.05 0.03 0.07"/>
            </geometry>
        </collision>
    </link>

    <joint name="arm_left_cutter_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 ${pi * 5 / 4}" />
        <parent link="arm_left_ft_link" />
        <child link="arm_left_cutter_link" />
    </joint>



    <link name="blade_link" >
        <visual>
            <material name="gray" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://horti_description/meshes/cutter/blade.STL"/>
            </geometry>
        </visual>
    </link>

    <joint name="blade_joint" type="revolute" >
        <origin xyz="0.0 0 0.10525" rpy="${pi/2} ${pi / 8} ${pi} " />
        <parent link="arm_left_cutter_link" />
        <child link="blade_link" />
        <axis xyz="0 0 -1" />
        <limit lower="0" upper="1.1" effort="50" velocity="3.14" />
    </joint>



    <link name="arm_left_eef_link" />
    <joint name="arm_left_eef_joint" type="fixed" >
        <origin xyz="0 0 ${0.13}" rpy="0 0 0" />
        <parent link="arm_left_cutter_link" />
        <child link="arm_left_eef_link" />
    </joint>

    <xacro:sensor_d405 parent="arm_left_cutter_link" name="cutter_cam">
        <origin xyz="0 -0.09738 0.03953" rpy="0 ${-(90 + 20) * pi / 180} ${-pi / 2}" />
    </xacro:sensor_d405>



    <!-- calibration marker -->

    <xacro:if value="${enable_cali_marker}">

        <link name="arm_right_marker_calib_link" />
        <joint name="arm_right_marker_calib_joint" type="fixed" >

            <origin xyz="${0.039 + 0.0027} 0 -0.0114" rpy="${pi/2} 0 ${pi/2}" />
            <parent link="arm_right_ft_link" />
            <child link="arm_right_marker_calib_link" />
        </joint>

        <link name="arm_right_marker_link" >
            <visual>
                <material name="gray" />
                <origin xyz="0 0 0.0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/ft_sensor/Marker_mid.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0.0" rpy="0 0 0" />
                <geometry>
                    <box size="0.07 0.07 0.005" />
                </geometry>
            </collision>
        </link>

        <joint name="arm_right_marker_joint" type="fixed" >
            <xacro:right_marker_calib />
            <parent link="arm_right_marker_calib_link" />
            <child link="arm_right_marker_link" />
        </joint>


        <link name="arm_left_marker_calib_link" />
        <joint name="arm_left_marker_calib_joint" type="fixed" >

            <origin xyz="${0.039 + 0.0027} 0 -0.0114" rpy="0 ${-pi/2} ${pi}" />
            <parent link="arm_left_ft_link" />
            <child link="arm_left_marker_calib_link" />
        </joint>

        <link name="arm_left_marker_link" >
            <visual>
                <material name="gray" />
                <origin xyz="0 0 0.0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://horti_description/meshes/ft_sensor/Marker_mid.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0.0" rpy="0 0 0" />
                <geometry>
                    <box size="0.07 0.07 0.005" />
                </geometry>
            </collision>
        </link>

        <joint name="arm_left_marker_joint" type="fixed" >
            <xacro:left_marker_calib />
            <parent link="arm_left_marker_calib_link" />
            <child link="arm_left_marker_link" />
        </joint>

    </xacro:if>



<!-- Head -->
    <!-- <xacro:property name="head_height" value="0.3" />
    <xacro:property name="head_mount_width" value="0.15" />

    <link name="head_mount_link" >
        <visual>
        <material name="gray" />
        <origin xyz="0 0 -${head_height}" rpy="0 0 ${pi/2}" />
            <geometry>
                <mesh filename="package://horti_description/meshes/lite6/visual/Lite6Holder_30deg.stl"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -${head_height}" rpy="0 0 ${pi/2}" />
            <geometry>
                <mesh filename="package://horti_description/meshes/lite6/visual/Lite6Holder_30deg.stl"/>
            </geometry>
        </collision>
    </link>
    <joint name="head_mount_joint" type="fixed" >
        <origin xyz="0 0.08 ${head_height}" rpy="0 0 ${-pi/2}" />
        <parent link="arm_holder_link" />
        <child link="head_mount_link" />
    </joint> -->

    <!-- head mount calibration link -->
    <!-- <link name="head_mount_link_calib" />
    <joint name="head_mount_calib_joint" type="fixed" >
        <parent link="head_mount_link" />
        <child link="head_mount_link_calib" />
        <xacro:head_arm_calib />
    </joint>

    <xacro:property name="head_mount_angle" value="${30 * pi / 180.0}" />
    <xacro:property name="head_mount_shift" value="0.008" />

	<xacro:lite6_robot prefix="head_" namespace="" limited="true" attach_to='head_mount_link_calib' xyz="${head_mount_shift * cos(head_mount_angle)} 0.0 -${head_mount_shift * sin(head_mount_angle)}" rpy=" 0 ${head_mount_angle} 0" />



    <link name="camera_holder_link">
        <visual>
        <material name="gray" />
        <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://horti_description/meshes/camera/cam_holder.stl" scale="0.001 0.001 0.001" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://horti_description/meshes/camera/cam_holder.stl" scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
    </link>
    <joint name="camera_holder_joint" type="fixed" >
        <origin xyz="0 0 0" rpy="0 0 ${pi/4}" />
        <parent link="head_link_eef" />
        <child link="camera_holder_link" />
    </joint> -->

    <!-- zed holder-->
    <link name="camera_holder_link" />

    <joint name="camera_holder_joint" type="fixed" >
        <origin xyz="-0.1 0.1 -0.05" rpy="0 ${10 * pi/180} -${pi/4}" />
        <parent link="arm_left_link7" />
        <child link="camera_holder_link" />
    </joint>

    <!-- zed calibration link -->
    <link name="zed_calib_link" />
    <joint name="zed_calib_joint" type="fixed" >
        <parent link="camera_holder_link" />
        <child link="zed_calib_link" />
        <xacro:cam_calib />
    </joint>

    <xacro:zed_camera name="zed2i" model="zed2i" parent="zed_calib_link">
        <origin xyz="-0.015 0 0.00" rpy="${pi} ${-pi/2} 0.0" />
    </xacro:zed_camera>

    <link name="zed2i_collision_link">
        <collision>
            <geometry>
                <mesh filename="package://horti_description/meshes/zed/zed2i.stl" />
            </geometry>
        </collision>
    </link>

    <joint name="zed2i_collision_joint" type="fixed" >
        <origin xyz="0.01 0 0.02" rpy="${pi} ${-pi/2} 0.0" />
        <parent link="camera_holder_link" />
        <child link="zed2i_collision_link" />
    </joint>


    <!-- realsense calibration link -->
    <link name="realsense_calib_link" />
    <joint name="realsense_calib_joint" type="fixed" >
        <parent link="camera_holder_link" />
        <child link="realsense_calib_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>


