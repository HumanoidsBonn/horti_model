<?xml version="1.0"?>
<robot name="horti" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="capsule-collision" params="e1 e2 rad len rpy mid">
		<collision>
			<origin rpy="${rpy}" xyz="${e1}" />
			<geometry>
				<sphere radius="${rad}" />
			</geometry>
		</collision>
		<collision>
			<origin rpy="${rpy}" xyz="${mid}" />
			<geometry>
				<cylinder length="${len}" radius="${rad}" />
			</geometry>
		</collision>
		<collision>
			<origin rpy="${rpy}" xyz="${e2}" />
			<geometry>
				<sphere radius="${rad}" />
			</geometry>
		</collision>
	</xacro:macro>

    <xacro:macro name="horti_bot" params="limited:='false' effort_control:='false' enable_d435i:='true'">

    <material name="gray">
		<color rgba="0.4 0.4 0.4 1"/>
	</material>
	 <material name="Black">
      <color rgba="0.0 0.0 0.0 1.0"/>
    </material>

    <material name="Red">
      <color rgba="0.8 0.0 0.0 1.0"/>
    </material>

    <material name="White">
      <color rgba="1.0 1.0 1.0 1.0"/>
    </material>

    <material name="Silver">
      <color rgba="0.753 0.753 0.753 1.0"/>
    </material>

    <xacro:include filename="$(find horti_description)/urdf/inc/xarm/xarm7_robot_macro.xacro" />
    <xacro:include filename="$(find horti_description)/urdf/inc/xarm/lite6_robot_macro.xacro" />
    <xacro:include filename="$(find horti_description)/urdf/inc/trolley/trolley_macro_d435.xacro" />


    <!-- Trolley -->

    <xacro:property name="holder_length" value="1.44" />
    <xacro:property name="holder_width" value="0.42" />
    <xacro:property name="holder_height" value="0.03" />
    <xacro:property name="arm_width" value="0.7" />
    <xacro:property name="arm_y_offset" value="-0.1" />

    <xacro:trollomatic enable_collisions="false" enable_inertia="false" joint_type="fixed"/>
    <joint name="base_link_joint" type="fixed" >
        <origin xyz="0.0 0 0" rpy="0.0 0 1.5708" />
        <parent link="world" />
        <child link="trolley_base_link" />
    </joint>

    <link name="arm_holder_link">
        <visual>
            <material name="gray" />
            <origin xyz="0 0 -${holder_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${holder_length} ${holder_width} ${holder_height}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -${holder_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${holder_length} ${holder_width} ${holder_height}" />
            </geometry>
        </collision>
    </link>
    <joint name="arm_holder_joint" type="fixed" >
        <origin xyz="${-holder_length / 2} 0 ${holder_height+0.05}" rpy="0 0 0" />
        <parent link="trolley_platform_link" />
        <child link="arm_holder_link" />
    </joint>

    <xacro:property name="back_height" value="1.5" />
    <link name="trolley_back_link">
        <visual>
            <material name="gray" />
            <origin xyz="0 0 ${back_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${holder_length} 0.001 ${back_height}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 ${back_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${holder_length} 0.001 ${back_height}" />
            </geometry>
        </collision>
    </link>
    <joint name="trolley_back_joint" type="fixed" >
        <origin xyz="${-holder_length / 2} ${holder_width / 2 + 0.05} 0" rpy="0 0 0" />
        <parent link="trolley_platform_link" />
        <child link="trolley_back_link" />
    </joint>


    <xacro:property name="power_height" value="0.35" />
    <xacro:property name="power_width" value="0.10" />
    <xacro:property name="power_length" value="0.45" />
    <link name="power_link" >
        <visual>
            <material name="gray" />
            <origin xyz="0 ${-power_width / 2} ${power_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${power_length} ${power_width} ${power_height}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 ${-power_width / 2} ${power_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${power_length} ${power_width} ${power_height}" />
            </geometry>
        </collision>
    </link>
    <joint name="power_joint" type="fixed">
        <parent link="trolley_base_link"/>
        <child link="power_link" />
        <origin xyz="${-1.44 / 2} ${-0.42 / 2 - 0.01} 0.18" rpy="0 0 0" />
    </joint>


    <xacro:property name="base_control_height" value="0.12" />
    <xacro:property name="base_control_width" value="0.15" />
    <xacro:property name="base_control_length" value="0.3" />
    <link name="base_control_link" >
        <visual>
            <material name="gray" />
            <origin xyz="0 ${-base_control_width / 2} ${base_control_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${base_control_length} ${base_control_width} ${base_control_height}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 ${-base_control_width / 2} ${base_control_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${base_control_length} ${base_control_width} ${base_control_height}" />
            </geometry>
        </collision>
    </link>
    <joint name="base_control_joint" type="fixed">
        <parent link="trolley_base_link"/>
        <child link="base_control_link" />
        <origin xyz="${-1.44 / 2 + 0.5} ${-0.42 / 2 - 0.01} 0.18" rpy="0 0 0" />
    </joint>


    <xacro:property name="basket_height" value="0.15" />
    <xacro:property name="basket_width" value="0.15" />
    <xacro:property name="basket_length" value="0.4" />
    <link name="basket_link" >
        <visual>
            <material name="gray" />
            <origin xyz="0 0 ${basket_height / 2 + 0.04}" rpy="0 0 0" />
            <geometry>
                <box size="${basket_length} ${basket_width} ${basket_height}" />
            </geometry>
        </visual>
        <!-- <collision>
            <origin xyz="0 0 ${basket_height / 2 + 0.04}" rpy="0 0 0" />
            <geometry>
                <box size="${basket_length} ${basket_width} ${basket_height}" />
            </geometry>
        </collision> -->
    </link>
    <joint name="basket_joint" type="fixed">
        <parent link="trolley_platform_link"/>
        <child link="basket_link" />
        <origin xyz="${-1.44 + basket_length / 2} ${-0.42 / 2 - 0.01 - basket_width / 2} 0.14" rpy="${pi} 0 0" />
    </joint>


    <link name="trolley_local_link" />
    <joint name="trolley_local_joint" type="fixed" >
        <origin xyz="0 0 0" rpy="0 0 ${pi}" />
        <parent link="trolley_platform_link" />
        <child link="trolley_local_link" />
    </joint>

<!-- Arms -->

    <xacro:xarm7_robot prefix="arm_right_" namespace="" limited="false" attach_to='arm_holder_link' xyz="${-arm_width / 2} ${arm_y_offset} 0.0" rpy="0 0 ${-pi/2}" />

    <xacro:xarm7_robot prefix="arm_left_" namespace="" limited="false" attach_to='arm_holder_link' xyz="${arm_width / 2} ${arm_y_offset} 0.0" rpy="0 ${0 * pi / 180.0} ${-pi/2}" />


<!-- FT-Sensors -->

    <xacro:property name="ft_height" value="0.0222" />
	<xacro:property name="ft_radius" value="0.04" />

    <xacro:macro name="ft_and_gripper" params="prefix parent">

        <link name="${prefix}_ft_link">
            <visual>
                <origin xyz="0 0 -${ft_height/2}" rpy="0 0 0" />
                <material name="gray" />
                <geometry>

                    <cylinder radius="${ft_radius}" length="${ft_height}" />
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 -${ft_height/2}" rpy="0 0 0" />
                <material name="gray" />
                <geometry>
                    <cylinder radius="${ft_radius}" length="${ft_height}" />
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}_ft_joint" type="fixed">
            <origin xyz="0 0 ${ft_height}" rpy="0 0 0" />
            <parent link="${parent}" />
            <child link="${prefix}_ft_link" />
        </joint>
    </xacro:macro>

    <xacro:ft_and_gripper prefix="arm_right" parent="arm_right_link7" />
    <xacro:ft_and_gripper prefix="arm_left" parent="arm_left_link7" />

    <!-- right gripper & eef link -->

    <link name="arm_right_gripper_link">
        <visual>
            <material name="gray" />
            <origin xyz="0 0 0.0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://horti_description/meshes/gripper/4Finger_visual.stl" scale="0.001 0.001 0.001" />
            </geometry>
        </visual>
    <!--<collision>
            <origin xyz="0 0 -0.04" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://horti_description/meshes/gripper/4Finger_collision.stl" scale="0.001 0.001 0.001" />
            </geometry>
        </collision>-->
        <xacro:capsule-collision e1="-0.000373856 -0.00111577 0.05043" e2="1.2756e-05 0.000562519 0.00209387" rad="0.048421797225357054" len="0.048366796323702978" rpy="-3.10689 0.00799342 -0.452684" mid="-0.00018055 -0.000276625 0.0262619" />
    </link>

    <joint name="arm_right_gripper_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 ${-pi/4}" />
        <parent link="arm_right_ft_link" />
        <child link="arm_right_gripper_link" />
    </joint>

    <link name="arm_right_eef_link" />
    <joint name="arm_right_eef_joint" type="fixed" >
        <origin xyz="0 0 0.08" rpy="0 0 0" />
        <parent link="arm_right_gripper_link" />
        <child link="arm_right_eef_link" />
    </joint>


    <!-- left gripper & eef link -->

    <xacro:property name="cylinder_length" value="0.1" />

    <link name="arm_left_gripper_link">
        <visual>
            <material name="gray" />
            <origin xyz="0 0 ${cylinder_length / 2}" rpy="0 0 0" />
            <geometry>
                <cylinder length="${cylinder_length}" radius="0.03" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 ${cylinder_length / 2}" rpy="0 0 0" />
            <geometry>
                <cylinder length="${cylinder_length}" radius="0.03" />
            </geometry>
        </collision>
    </link>

    <joint name="arm_left_gripper_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="arm_left_ft_link" />
        <child link="arm_left_gripper_link" />
    </joint>

    <link name="arm_left_eef_link" />
    <joint name="arm_left_eef_joint" type="fixed" >
        <origin xyz="0 0 ${cylinder_length}" rpy="0 0 0" />
        <parent link="arm_left_gripper_link" />
        <child link="arm_left_eef_link" />
    </joint>





<!-- Head -->
    <xacro:property name="head_height" value="0.4" />
    <xacro:property name="head_mount_width" value="0.15" />

    <link name="head_mount_link" >
        <visual>
        <material name="gray" />
        <origin xyz="0 0 ${-head_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${head_mount_width} ${head_mount_width} ${head_height}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 ${-head_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${head_mount_width} ${head_mount_width} ${head_height}" />
            </geometry>
        </collision>
    </link>
    <joint name="head_mount_joint" type="fixed" >
        <origin xyz="0 0.08 ${head_height}" rpy="0 0 ${-pi/2}" />
        <parent link="arm_holder_link" />
        <child link="head_mount_link" />
    </joint>

	<xacro:lite6_robot prefix="head_" namespace="" limited="true" attach_to='head_mount_link' xyz="0 0.0 0.0" rpy=" 0 ${45*pi / 180.0} 0" />


    <link name="zed2i_holder_link">
        <visual>
        <material name="gray" />
        <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://horti_description/meshes/camera/ZED2i_adaptor.STL" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://horti_description/meshes/camera/ZED2i_adaptor.STL" />
            </geometry>
        </collision>
    </link>
    <joint name="zed2i_holder_joint" type="fixed" >
        <origin xyz="0 0 0" rpy="0 0 ${pi/4}" />
        <parent link="head_link_eef" />
        <child link="zed2i_holder_link" />
    </joint>

    <link name="zed2i_link">
        <visual>
        <material name="gray" />
        <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://horti_description/meshes/camera/zed2i.stl" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://horti_description/meshes/camera/zed2i.stl" />
            </geometry>
        </collision>
    </link>
    <joint name="zed2i_joint" type="fixed" >
        <!-- transform estimated -->
        <origin xyz="0 0 0.044" rpy="${pi} ${-pi/2} 0" />
        <parent link="zed2i_holder_link" />
        <child link="zed2i_link" />
    </joint>


</xacro:macro>


</robot>
