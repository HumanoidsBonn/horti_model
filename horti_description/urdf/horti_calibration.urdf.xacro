    <origin xyz="-0.003050 -0.004915 -0.020024" rpy="0.03518124 -0.01505477 -0.00135560" /> <!-- 2.193° in total -->
</xacro:macro>

<!-- Calibrated arm_left_mount_link in arm_left_calib_link -->
<xacro:macro name="left_arm_calib">
    <origin xyz="0.012408 0.006294 0.010248" rpy="0.02596279 -0.00447181 -0.00729895" /> <!-- 1.565° in total -->
</xacro:macro>

<!-- Calibrated arm_left_marker_link in arm_left_marker_calib_link -->
<xacro:macro name="left_marker_calib">
    <origin xyz="0.000000 0.000000 0.000000" rpy="0.00000000 -0.00000000 3.14159265" /> <!-- 180.000° in total -->
</xacro:macro>

<!-- Calibrated arm_right_marker_link in arm_right_marker_calib_link -->
