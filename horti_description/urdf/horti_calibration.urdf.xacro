    <origin xyz="0.009449 -0.001948 0.018988" rpy="-0.00406026 -0.01964568 -0.00556291" /> <!-- 1.193° in total -->
</xacro:macro>

<!-- Calibrated head_mount_link_calib in head_mount_link -->
