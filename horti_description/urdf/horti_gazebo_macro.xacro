<robot name="horti" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 	<xacro:include filename="$(find avatar_model)/robots/helpers.urdf.xacro" /> -->
    <!-- 	<xacro:property name="arm_height" value="1.1" /> -->
    <!--
  Author: Jimy Zhang <jimy.zhang@ufactory.cc> <jimy92@163.com>
  Contributers:
-->
    <xacro:macro name="horti_gazebo" params="limited:='false' effort_control:='false' enable_d435i:='true' enable_d405:='true'">  

        <gazebo>
            <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
                <robotNamespace>/</robotNamespace>
                <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
                <legacyModeNS>true</legacyModeNS>
            </plugin>
        </gazebo>

        <xacro:include filename="$(find horti_description)/urdf/horti_macro.xacro" />
        <xacro:horti_bot limited='false' effort_control='false' enable_d435i='true' />

        <xacro:if value="${enable_d435i}">
            <xacro:include filename="$(find horti_description)/urdf/inc/sensors/depth_camera.xacro" />
            <xacro:depth_camera prefix='head_'  camera_name="camera_d435i" hfov="87" min_depth="0.3" max_depth= "1.0" parent='link_eef' />
        </xacro:if>

        <xacro:if value="${enable_d405}">
            <xacro:include filename="$(find horti_description)/urdf/inc/sensors/depth_camera.xacro" />
            <xacro:depth_camera prefix='head_'  camera_name="camera_d405" hfov="87" min_depth="0.07" max_depth= "0.30" parent='link_eef' />
        </xacro:if>
    
    </xacro:macro>

    
</robot>