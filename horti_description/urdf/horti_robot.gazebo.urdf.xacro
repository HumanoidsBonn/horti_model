<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="horti" >
    <material name="gray">
        <color rgba="0.4 0.4 0.4 1" />
    </material>
    <material name="Black">
        <color rgba="0.0 0.0 0.0 1.0" />
    </material>
    <material name="Red">
        <color rgba="0.8 0.0 0.0 1.0" />
    </material>
    <material name="White">
        <color rgba="1.0 1.0 1.0 1.0" />
    </material>
    <material name="Silver">
        <color rgba="0.753 0.753 0.753 1.0" />
    </material>
    
    <xacro:arg name="transmission_hw_interface" default="hardware_interface/PositionJointInterface"/>

    <xacro:include filename="$(find horti_description)/urdf/horti.urdf.xacro"/>


    <xacro:gazebo_ros_control_plugin namespace=""/>

    <link name='world' />

    <xacro:trollomatic prefix="" arm_prefix="arm_" transmission_hw_interface="$(arg transmission_hw_interface)" joint_type="fixed" /> -->
    <link name="arm_holder_link">
        <!-- <visual>
            <material name="gray" />
            <origin xyz="0 0 ${holder_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${holder_length} ${holder_width} ${holder_height}" />
            </geometry>
        </visual> -->
        <!-- <collision>
            <origin xyz="0 0 ${holder_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${holder_length} ${holder_width} ${holder_height}" />
            </geometry>
        </collision> -->
        <!-- <inertial>
            <mass value="5.0" />
            <origin rpy="0 0 0" xyz="0.0 0.0 0.00" />
            <inertia ixx="0.000468" iyy="0.007" izz="0.075" ixy="0.0" ixz="0.0" iyz="0.0" />
        </inertial> -->
   </link> 
    <joint name="arm_holder_joint" type="fixed" >
        <origin xyz="${holder_length / 2 + 0.1} 0 ${holder_height/2}" rpy="0 0 ${pi}" />
        <parent link="platform_base" />
        <child link="arm_holder_link" />
    </joint>

    <!-- Arms -->

    <!--Left Arm-->
    <xacro:xarm7_urdf prefix="arm_left_"/>
    <joint name="arm_left_base_joint" type="fixed" >
        <origin xyz="${-arm_width / 2} ${-arm_y_offset } ${holder_height}" rpy="0 0 ${-pi/2}" />
        <parent link="arm_holder_link" />
        <child link="arm_left_link_base" />
    </joint>
    <xacro:xarm7_transmission prefix="arm_left_" hard_interface="PositionJointInterface" />
    <xacro:xarm7_gazebo prefix="arm_left_" />

    <!--Right Arm-->
    <xacro:xarm7_urdf prefix="arm_right_"/>
    <joint name="arm_right_base_joint" type="fixed" >
        <origin xyz="${arm_width / 2} ${-arm_y_offset} ${holder_height}" rpy="0 0 ${-pi/2}" />
        <parent link="arm_holder_link" />
        <child link="arm_right_link_base" />
    </joint>
    <xacro:xarm7_transmission prefix="arm_right_" hard_interface="PositionJointInterface" />
    <xacro:xarm7_gazebo prefix="arm_right_" />

    <!-- Head -->
    <xacro:property name="pedestal_height" value="0.1" />
    <xacro:lite6_urdf prefix="head" />
    <!-- <link name="head_pedestal_link">
        <visual>
            <material name="White" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.14 0.13 ${pedestal_height}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.14 0.13 ${pedestal_height}" />
            </geometry>
        </collision>
    </link>
    <joint name="head_pedestal_joint" type="fixed" >
        <origin xyz="0 0 ${holder_height + pedestal_height/2}" rpy="0 0 0.0" />
        <parent link="world" />
        <child link="head_pedestal_link" />
    </joint> -->
     <joint name="head_base_joint" type="fixed" >
        <origin xyz="0 ${-arm_y_offset} ${pedestal_height/2}" rpy="0 0 -${pi/2}" />
        <parent link="arm_holder_link" />
        <child link="head_base_link" />
    </joint>
    <xacro:xarm6_transmission prefix="head_" hard_interface="PositionJointInterface" />
    <xacro:xarm6_gazebo prefix="head_" />
    
    <xacro:depth_camera prefix="head_" parent="eef_link"/>

</robot>

