<?xml version="1.0"?>
<robot name="horti" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- 	<xacro:include filename="$(find avatar_model)/robots/helpers.urdf.xacro" /> -->
<!-- 	<xacro:property name="arm_height" value="1.1" /> -->

    <xacro:include filename="$(find horti_description)/urdf/inc/xarm/xarm7_robot_macro.xacro" />
    <xacro:include filename="$(find horti_description)/urdf/inc/xarm/lite6_robot_macro.xacro" />
    <xacro:include filename="$(find horti_description)/urdf/inc/trolley/trolley_macro_d435.xacro" />
    
	<material name="gray">
		<color rgba="0.4 0.4 0.4 1"/>
	</material>
	 <material name="Black">
      <color rgba="0.0 0.0 0.0 1.0"/>
    </material>

    <material name="Red">
      <color rgba="0.8 0.0 0.0 1.0"/>
    </material>

    <material name="White">
      <color rgba="1.0 1.0 1.0 1.0"/>
    </material>

    <material name="Silver">
      <color rgba="0.753 0.753 0.753 1.0"/>
    </material>

    <xacro:property name="holder_length" value="1.3" />
    <xacro:property name="holder_width" value="0.32" />
    <xacro:property name="holder_height" value="0.1" />
    <xacro:property name="arm_width" value="0.9" />
    <xacro:property name="arm_y_offset" value="0.08" />

	<link name="map"/>
    <link name="world"/>
    <joint name="world_joint" type="fixed" >
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="map" />
        <child link="world" />
    </joint>
    
    <xacro:trollomatic enable_collisions="false" enable_inertia="false" />
    <joint name="base_link_joint" type="fixed" >
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="map" />
        <child link="base_link" />
    </joint>
    
    <link name="arm_holder_link">
        <visual>
            <material name="gray" />
            <origin xyz="0 0 -${holder_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${holder_length} ${holder_width} ${holder_height}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -${holder_height / 2}" rpy="0 0 0" />
            <geometry>
                <box size="${holder_length} ${holder_width} ${holder_height}" />
            </geometry>
        </collision>
    </link>
    <joint name="arm_holder_joint" type="fixed" >
        <origin xyz="${holder_length/2} 0 ${holder_height}" rpy="0 0 ${pi}" />
        <parent link="platform_base" />
        <child link="arm_holder_link" />
    </joint>


<!-- Arms -->
    <xacro:xarm7_robot prefix="arm_right_" namespace="" limited="true" attach_to='arm_holder_link' xyz="${-arm_width / 2} ${arm_y_offset} 0.0" rpy="0 0 ${-pi/4}" />
    

    <xacro:xarm7_robot prefix="arm_left_" namespace="" limited="true" attach_to='arm_holder_link' xyz="${arm_width / 2} ${arm_y_offset} 0.0" rpy="0 0 ${-3*pi/4}" />


<!-- Head -->
	<xacro:lite6_robot prefix="head_" namespace="" limited="true" attach_to='arm_holder_link' xyz="0 0 0.6" rpy=" 0 0 ${-pi/2}" />



</robot>
