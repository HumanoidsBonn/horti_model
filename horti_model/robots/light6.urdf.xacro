<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:macro name="light6_urdf" params="prefix">

        <link name ="${prefix}_base_link">
            <visual>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_model/meshes/light6/base.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
        </link>

        <link name ="${prefix}_link1">
            <visual>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_model/meshes/light6/link1.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
        </link>

        <joint name="${prefix}_joint1" type="revolute" >
            <origin xyz="0 0 0.173" rpy="0 0 0" />
            <parent link="${prefix}_base_link" />
            <child link="${prefix}_link1" />
            <axis xyz="0 0 1" />
            <limit lower="${-2* pi}" upper="${2 * pi }" effort="20" velocity="3.14" />
        </joint>

        <link name ="${prefix}_link2">
            <visual>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_model/meshes/light6/link2.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
        </link>

        <joint name="${prefix}_joint2" type="revolute" >
            <origin xyz="0 0.073 0.07" rpy="0 0 0" />
            <parent link="${prefix}_link1" />
            <child link="${prefix}_link2" />
            <axis xyz="0 1 0" />
            <limit lower="${-2* pi}" upper="${2 * pi }" effort="20" velocity="3.14" />
        </joint>

        <link name ="${prefix}_link3">
            <visual>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_model/meshes/light6/link3.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
        </link>

        <joint name="${prefix}_joint3" type="revolute" >
            <origin xyz="0 -0.028 0.2" rpy="0 0 0" />
            <parent link="${prefix}_link2" />
            <child link="${prefix}_link3" />
            <axis xyz="0 1 0" />
            <limit lower="${-2* pi}" upper="${2 * pi }" effort="20" velocity="3.14" />
        </joint>

        <link name ="${prefix}_link4">
            <visual>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_model/meshes/light6/link4.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
        </link>

        <joint name="${prefix}_joint4" type="revolute" >
            <origin xyz="0.087 -0.0447 -0.035" rpy="0 0 0" />
            <parent link="${prefix}_link3" />
            <child link="${prefix}_link4" />
            <axis xyz="0 0 1" />
            <limit lower="${-2* pi}" upper="${2 * pi }" effort="20" velocity="3.14" />
        </joint>

        <link name ="${prefix}_link5">
            <visual>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_model/meshes/light6/link5.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
        </link>

        <joint name="${prefix}_joint5" type="revolute" >
            <origin xyz="0 0.0415 -0.1921" rpy="0 0 0" />
            <parent link="${prefix}_link4" />
            <child link="${prefix}_link5" />
            <axis xyz="0 1 0" />
            <limit lower="${-2* pi}" upper="${2 * pi }" effort="20" velocity="3.14" />
        </joint>

        <link name ="${prefix}_link6">
            <visual>
                <material name="gray" />
                <geometry>
                    <mesh filename="package://horti_model/meshes/light6/link6.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
        </link>

        <joint name="${prefix}_joint6" type="revolute" >
            <origin xyz="0 -0.0415 -0.0408" rpy="0 0 0" />
            <parent link="${prefix}_link5" />
            <child link="${prefix}_link6" />
            <axis xyz="0 0 1" />
            <limit lower="${-2* pi}" upper="${2 * pi }" effort="20" velocity="3.14" />
        </joint>

        <link name="${prefix}_eef_link" />

        <joint name="${prefix}_eef_joint" type="fixed" >
            <origin xyz="0 0 -0.0245" rpy="0 0 0" />
            <parent link="${prefix}_link6" />
            <child link="${prefix}_eef_link" />
        </joint>


    </xacro:macro>


</robot>
