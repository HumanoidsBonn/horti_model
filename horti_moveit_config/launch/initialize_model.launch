<?xml version="1.0"?>
<launch>
  <arg name="node_start_delay" default="5.0" />  

    <node name="set_model_config" pkg="horti_moveit_config" type="set_model_config.py" output="screen" launch-prefix="bash -c 'sleep $(arg node_start_delay); $0 $@' "/>

  <arg name="controller_config_file" default="$(find horti_description)/config/gazebo_controllers.yaml" doc="Config file used for defining the ROS-Control controllers."/>
  <rosparam file="$(arg controller_config_file)" command="load"/>
  <arg name="stopped_controllers" default="left_arm_pos_joint_group_pos_controller right_arm_pos_joint_group_pos_controller head_pos_joint_group_pos_controller" doc="Controllers that are initally loaded, but not started."/>
  

  <!-- Load other controllers, but do not start them -->
  <node name="ros_control_stopped_spawner" pkg="controller_manager" type="spawner"
    args="--stopped $(arg stopped_controllers)" output="screen" respawn="false" launch-prefix="bash -c 'sleep $(arg node_start_delay); $0 $@' "/>
    <arg name="controllers" default="joint_state_controller arm_left_controller arm_right_controller head_controller" doc="Controllers that are activated by default."/>
    <!-- Load and start the controllers listed in the 'controllers' arg. -->
  <node name="ros_control_controller_spawner" pkg="controller_manager" type="controller_manager"
    args="spawn $(arg controllers)" output="screen" respawn="false"  launch-prefix="bash -c 'sleep $(arg node_start_delay); $0 $@' "/>

</launch>
